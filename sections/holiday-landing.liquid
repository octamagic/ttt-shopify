        {%- for block in section.blocks -%}
          {%- if block.type == 'faq' -%}
            <div class="hl-faq__item" {{ block.shopify_attributes }}>
              <button type="button" class="hl-faq__q" aria-expanded="false" aria-controls="hl-faq-{{ section.id }}-{{ forloop.index }}">{{ block.settings.q }}<span aria-hidden="true">+</span></button>
              <div class="hl-faq__a" id="hl-faq-{{ section.id }}-{{ forloop.index }}" hidden>{{ block.settings.a }}</div>
            </div>
          {%- endif -%}
