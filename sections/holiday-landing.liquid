  {%- comment -%} 8. SMALL BUSINESS SATURDAY (date-conditional) {%- endcomment -%}
  {%- if show_sbs -%}
  <section class="hl-sbs">
    <div class="hl-wrap hl-sbs__inner">
      <div>
        <p class="hl-eyebrow">Small Business Saturday</p>
        <h2>{{ s.sbs_headline | default: 'Made by a small team of makers across America' }}</h2>
      </div>
      <p>{{ s.sbs_body | default: 'There is no warehouse algorithm behind this. There is a loom we designed, a patent we were granted, a 3PL in the US that gets your order out within 24 hours, and a few people who answer the support inbox themselves. Buying from us today keeps that going.' }}</p>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} 9. FAQ {%- endcomment -%}
  <section class="hl-sec">
    <div class="hl-wrap">
      <p class="hl-eyebrow">Before you decide</p>
