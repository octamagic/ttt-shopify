{%- liquid
  assign lifestyle = false
  if section.settings.layout == 'lifestyle' and section.settings.image != blank
    assign lifestyle = true
  endif
  assign show_compare = false
  if lifestyle == false and section.settings.image_before != blank and section.settings.image_after != blank
    assign show_compare = true
  endif
-%}
{{ 'section-hero-dark.css' | asset_url | stylesheet_tag }}
{%- if show_compare -%}
  {{ 'section-before-after.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<div
  id="{{ section.id }}"
  class="screen-fit hero-dark hero-dark--align-{{ section.settings.text_alignment | default: 'center' }}{% if lifestyle %} hero-dark--lifestyle{% endif %} pt pb sm-pt sm-pb"
  style="
    --pt: {{ section.settings.padding_top | append: 'px' }};
    --pb: {{ section.settings.padding_bottom | append: 'px' }};
    --sm-pt: {{ section.settings.md_padding_top | append: 'px' }};
    --sm-pb: {{ section.settings.md_padding_bottom | append: 'px' }};
  "
>
  <div class="hero-dark__bg" aria-hidden="true"></div>

  <div class="hero-dark__inner container">
    <div class="hero-dark__grid">

      {%- comment -%} ── Left: Text ── {%- endcomment -%}
      <div class="hero-dark__text-col">

        {%- if section.settings.eyebrow != blank -%}
          <p class="hero-dark__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="hero-dark__title">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="hero-dark__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- comment -%}
          Social proof sits above the CTA, where it can still earn the click.
          The star rating and review count come from the product's review
          metafields (Judge.me keeps them current). The proof line shows
          when there is no rating to show.
        {%- endcomment -%}
        {%- liquid
          assign rating_product = section.settings.rating_product
          if rating_product == blank
            assign rating_product = all_products['string-ring-custom-string-art-kit']
          endif
          assign rating_count = rating_product.metafields.reviews.rating_count.value | default: 0
        -%}
        {%- if section.settings.show_rating and rating_count > 0 -%}
          {%- render 'rating-summary', product: rating_product, class: 'hero-dark__rating' -%}
        {%- elsif section.settings.proof_line != blank -%}
          <p class="hero-dark__proof">{{ section.settings.proof_line }}</p>
        {%- endif -%}

        <div class="hero-dark__buttons">
          {%- if section.settings.primary_button_label != blank -%}
            
              <a href="{{ section.settings.primary_button_link | default: '#' }}"
              class="hero-dark__btn hero-dark__btn--primary"
            >
              {{ section.settings.primary_button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.secondary_button_label != blank -%}
            
             <a href="{{ section.settings.secondary_button_link | default: '#' }}"
              class="hero-dark__btn hero-dark__btn--secondary"
            >
              {{ section.settings.secondary_button_label }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.caption != blank -%}
          <p class="hero-dark__caption">{{ section.settings.caption }}</p>
        {%- endif -%}

        {%- assign trust_items = section.blocks | where: 'type', 'trust_item' -%}
        {%- if trust_items.size > 0 -%}
          <ul class="hero-dark__trust" role="list">
            {%- for block in trust_items -%}
              {%- if block.settings.text != blank -%}
                <li class="hero-dark__trust-item" {{ block.shopify_attributes }}>
                  <span class="hero-dark__trust-icon">{%- render 'icon-trust', icon: block.settings.icon -%}</span>
                  <span>{{ block.settings.text | escape }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

      </div>

      {%- comment -%}
        ── Right: a lifestyle photo running to the screen edge, the
        before/after slider, or a single framed image ──
      {%- endcomment -%}
      {%- if lifestyle -%}
        <div class="hero-dark__image-col hero-dark__image-col--bleed">
          <div class="hero-dark__image hero-dark__image--bleed">
            {%- render 'img',
              lazyload: false,
              wrapped: false,
              sizes: '(min-width: 768px) 56vw, 100vw',
              src: section.settings.image
            -%}
          </div>
        </div>
      {%- elsif show_compare -%}
        <div class="hero-dark__image-col">
          <div class="hero-dark__image hero-dark__image--compare">
            {%- render 'before-after-image-slider', block: section, sizes: '(min-width: 768px) 50vw, 100vw' -%}
          </div>
        </div>
      {%- elsif section.settings.image != blank -%}
        <div class="hero-dark__image-col">
          <div class="hero-dark__image">
            {%- render 'img',
              lazyload: false,
              wrapped: false,
              src: section.settings.image
            -%}
          </div>
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Dark",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centered"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "split",
      "info": "Lifestyle runs the Image below to the edge of the screen and ignores the before/after slider.",
      "options": [
        {
          "value": "split",
          "label": "Text beside slider or framed image"
        },
        {
          "value": "lifestyle",
          "label": "Lifestyle photo to the edge"
        }
      ]
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (above heading)",
      "info": "Optional short line, e.g. a seasonal message."
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Your Photo. Your Art. Your Way."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A calming, hands-on art kit that turns meaningful photos into custom string art — no experience needed."
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating and review count",
      "default": true,
      "info": "From the product's reviews (Judge.me). Replaces the proof line when there are reviews."
    },
    {
      "type": "product",
      "id": "rating_product",
      "label": "Rating from product",
      "info": "Defaults to the Threaditate kit."
    },
    {
      "type": "text",
      "id": "proof_line",
      "label": "Proof line (above buttons)",
      "info": "Social proof shown between the subheading and the buttons."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Caption (below buttons)",
      "default": "Beginner-friendly • No experience needed"
    },
    {
      "type": "header",
      "content": "Primary button"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Label",
      "default": "Get my kit"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Secondary button"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "The lifestyle photo, or the framed image when no before/after pair is set. Set a focal point on the photo so the piece stays in frame on phones."
    },
    {
      "type": "header",
      "content": "Before / after slider"
    },
    {
      "type": "paragraph",
      "content": "Set both images to replace the hero image with a drag slider: the customer's photo on the left, the finished piece on the right."
    },
    {
      "type": "image_picker",
      "id": "image_before",
      "label": "Before (the photo)"
    },
    {
      "type": "image_picker",
      "id": "image_after",
      "label": "After (the string art)"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Your photo"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "Your string art"
    },
    {
      "type": "color",
      "id": "label_colors",
      "label": "Label text colour",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "label_position",
      "label": "Label position",
      "default": "top",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "media_aspect_ratio",
      "label": "Slider aspect ratio",
      "default": "square",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "natural",
          "label": "Natural"
        }
      ]
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "range",
      "id": "md_padding_top",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "md_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "header",
      "content": "Mobile layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Hero Dark",
      "category": "Custom"
    }
  ],
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust point",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "kits",
          "options": [
            {
              "value": "kits",
              "label": "Kits made (people)"
            },
            {
              "value": "patent",
              "label": "Patent (seal)"
            },
            {
              "value": "app",
              "label": "App (phone)"
            },
            {
              "value": "ship",
              "label": "Shipping (box)"
            },
            {
              "value": "guarantee",
              "label": "Guarantee (shield)"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "clock",
              "label": "Time"
            }
          ]
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "3,000+ kits made"
        }
      ]
    }
  ]
}
{% endschema %}