    "faq_with_image_TKFwQq": {
      "type": "faq-with-image",
      "blocks": {
        "faq_item_cjCmEG": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to send in my photo?",
            "answer": "<p>No, just upload to the Threaditate website and watch the string art generate in your own hands.  Edit the image and crop it just how you like, then click begin for your pattern to begin announcing.  It's all in your hands!</p>"
          }
        },
        "faq_item_kw7Xec": {
          "type": "faq_item",
          "settings": {
            "question": "Do I need any experience?",
            "answer": "<p>None at all. The app guides you through every step, one line at a time. If you can follow numbers, you can make a Threaditate.</p>"
          }
        },
        "faq_item_D8zJqt": {
          "type": "faq_item",
          "settings": {
            "question": "Can I use any photo?",
            "answer": "<p>Yes, although some photos look better than others. Try lots to learn what makes for the best thread art! Crisp portraits and close-ups with clear contrast and plain backgrounds come out best, since the app reads light and shadow. We built a menu stacked with editing features to fine tune your masterpiece. Make it just how you want the finished piece, then begin!</p>"
          }
        },
        "faq_item_JTeLJB": {
          "type": "faq_item",
          "settings": {
            "question": "How long does it take?",
            "answer": "<p>Most pieces take 5 to 8 hours, depending on the line count. The app saves your place after every line, so you can take breaks and go at your own pace.</p>"
          }
        },
        "faq_item_FBchyJ": {
          "type": "faq_item",
          "settings": {
            "question": "What if I make a mistake?",
            "answer": "<p>Forget it and just keep going. They will disappear as you keep going. If you lose your place, just continue with the next step. Countless mistakes blend right into the finished piece, so there is no need to hit the back button ever.</p>"
          }
        }
      },
